                format: "TIFF".into(),
                message: e.to_string(),
            };
            let mut metadata =
                tiff::decoder::Decoder::new(std::io::Cursor::new(&bytes)).map_err(error)?;
            metadata
                .find_tag(tiff::tags::Tag::IccProfile)
                .map_err(error)?
                .map(|value| value.into_u8_vec())
                .transpose()
                .map_err(error)?
