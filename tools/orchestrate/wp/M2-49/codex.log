    fn close(&self) {
        if let Ok(mut st) = self.state.lock() {
            st.closed = true;
            st.generation += 1;
            self.generation.store(st.generation, Ordering::SeqCst);
            if let Some(job) = st.job.take() {
                job.cancel();
            }
            st.surfaces.clear();
        }
    }
