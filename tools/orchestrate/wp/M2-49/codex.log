fn bipolar(v: f32) -> f32 {
    finite_or(v, 0.0).clamp(-100.0, 100.0)
}

fn unit(v: f32, default: f32) -> f32 {
    finite_or(v, default).clamp(0.0, 100.0)
}

fn bands(b: &HueBands) -> HueBands {
    HueBands {
