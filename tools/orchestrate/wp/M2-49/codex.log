/// Depth-based lens blur.
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
#[serde(default)]
pub struct LensBlur {
    /// Blur amount, `0..=100`.
    pub amount: f32,
    /// In-focus depth range, normalised `[near, far]`.
    pub focus_range: [f32; 2],
    /// Bokeh shape id.
    pub bokeh: String,
    /// Depth model used.
    pub depth_model: Option<ModelRef>,
}

impl Default for LensBlur {
    fn default() -> Self {
        Self {
            amount: 50.0,
            focus_range: [0.0, 0.1],
            bokeh: "circle".into(),
            depth_model: None,
        }
    }
}

