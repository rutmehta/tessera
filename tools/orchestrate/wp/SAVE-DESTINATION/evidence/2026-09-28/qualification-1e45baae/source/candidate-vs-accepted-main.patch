+    typealias SwiftType = DocumentSaveAsResult
+
+    public static func read(from buf: inout (data: Data, offset: Data.Index)) throws -> DocumentSaveAsResult {
+        let variant: Int32 = try readInt(&buf)
+        switch variant {
