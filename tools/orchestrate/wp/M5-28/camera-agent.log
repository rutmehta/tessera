    debug_assert!(completion.tiles.is_empty());
    debug_assert_eq!(backend.stats().uploads, 0);
    debug_assert_eq!(backend.stats().pixel_readback_bytes, 0);
    debug_assert_eq!(backend.stats().readbacks, 0);
