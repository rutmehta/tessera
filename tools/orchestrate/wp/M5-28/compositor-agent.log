fn smooth(t: f32) -> f32 {
    t * t * (3.0 - 2.0 * t)
}
fn power(v: f32, gamma: f32) -> f32 {
    if gamma == 1.0 { v } else { v.powf(1.0 / gamma) }
}
pub(crate) fn luminance(rgb: [f32; 3]) -> f32 {
    0.2126 * rgb[0] + 0.7152 * rgb[1] + 0.0722 * rgb[2]
}

