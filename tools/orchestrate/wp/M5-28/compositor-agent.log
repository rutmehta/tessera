            if (mx != mn) {
                let d = mx - mn;
                if (l > 0.5) { s = pdiv(d, 2.0 - mx - mn); } else { s = pdiv(d, mx + mn); }
                if (mx == c.x) { h = pdiv(c.y - c.z, d) + select(0.0, 6.0, c.y < c.z); }
                else if (mx == c.y) { h = pdiv(c.z - c.x, d) + 2.0; }
