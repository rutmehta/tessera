                             lut(o + 12288u, lut(o + 8192u, c.z)));
        }
        case 5u: {
            let r0 = steps[k].p[0];
            let r1 = steps[k].p[1];
            let r2 = steps[k].p[2];
            return vec3<f32>(r0.x * c.x + r0.y * c.y + r0.z * c.z + r0.w,
                             r1.x * c.x + r1.y * c.y + r1.z * c.z + r1.w,
                             r2.x * c.x + r2.y * c.y + r2.z * c.z + r2.w);
