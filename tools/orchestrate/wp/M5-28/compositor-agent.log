        add(&mut d, None, layer_fn("outside",e,Depth::F32,|_,_|[0.3,0.1,0.2,0.3]));
        let group = add(&mut d,None,Layer::group("group",mode));
        add(&mut d,Some(group),layer_fn("pixels",e,Depth::F32,|x,y|{
            let v=if x%37<18 {0.08} else {0.8};
            [v, v*0.7, v*0.9, if x%29==0 {0.0} else {0.3+(y%5) as f32*0.14}]
        }));
        for radius in [5.0,3.0] {
