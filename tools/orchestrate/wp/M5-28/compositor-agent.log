                (9, pb.as_entire_binding()),
                (10, fb.as_entire_binding()),
                (11, self.steps.binding()),
                (12, self.tables.binding()),
                (13, self.aux.binding()),
                (14, self.blocks.binding()),
                (15, out.as_entire_binding()),
