1 | use serde :: { Serialize , Deserialize } ; type ImageId = String ; type RecipeHash = String ; type IccProfileHandle = String ; type MaskId = u64 ; type PersonId = u64 ; type HistoryGroupId = u64 ; type StyleId = String ; type ModelId = String ; type Grade = u8 ; type Mark = String ; type DocumentId = u64 ; type LayerId = u64 ; type SelectionId = u64 ; type HistoryEntryId = u64 ; # [doc = " Partial update of global tone and colour controls. `None` leaves a"] # [doc = " control unchanged. Units as in [`crate::recipe::settings`]."] # [derive (Debug , Clone , PartialEq , Default , Serialize , Deserialize)] # [serde (default)] # [derive (schemars :: JsonSchema)] pub struct ToneUpdate { # [doc = " Exposure, EV."] pub exposure : Option < f32 > , # [doc = " Contrast."] pub contrast : Option < f32 > , # [doc = " Highlights."] pub highlights : Option < f32 > , # [doc = " Shadows."] pub shadows : Option < f32 > , # [doc = " Whites."] pub whites : Option < f32 > , # [doc = " Blacks."] pub blacks : Option < f32 > , # [doc = " Texture."] pub texture : Option < f32 > , # [doc = " Clarity."] pub clarity : Option < f32 > , # [doc = " Dehaze."] pub dehaze : Option < f32 > , # [doc = " Vibrance."] pub vibrance : Option < f32 > , # [doc = " Saturation."] pub saturation : Option < f32 > , # [doc = " White balance temperature, kelvin (switches WB to custom)."] pub temperature : Option < f32 > , # [doc = " White balance tint (switches WB to custom)."] pub tint : Option < f32 > , } # [doc = " How `remove_object` fills the removed area. Generative fill is"] # [doc = " deliberately absent: base edits are non-generative (spec 10 §2)."] # [derive (Debug , Clone , Copy , PartialEq , Eq , Default , Serialize , Deserialize)] # [serde (rename_all = "snake_case")] # [derive (schemars :: JsonSchema)] pub enum RemovalMethod { # [doc = " Engine choice between heal and inpaint."] # [default] Auto , # [doc = " Texture-synthesis heal."] Heal , # [doc = " Local inpainting model."] Inpaint , } # [doc =