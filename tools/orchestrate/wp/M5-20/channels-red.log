fit" , rename_all = "snake_case")] # [derive (schemars :: JsonSchema)] pub enum Resize { # [doc = " Fit the long edge."] LongEdge { # [doc = " Pixels."] pixels : u32 , } , # [doc = " Fit within a box."] Within { # [doc = " Width."] width : u32 , # [doc = " Height."] height : u32 , } , # [doc = " Target megapixels."] Megapixels { # [doc = " Megapixels."] megapixels : f32 , } , } # [doc = " Export settings."] # [derive (Debug , Clone , PartialEq , Serialize , Deserialize)] # [derive (schemars :: JsonSchema)] pub struct ExportSettings { # [doc = " Destination directory."] pub destination : String , # [doc = " File-name template, e.g. `\"{name}-{seq:3}\"`."] # [serde (default = "default_template")] pub name_template : String , # [doc = " Format."] pub format : ExportFormat , # [doc = " Output colour profile; `None` means sRGB."] # [serde (default)] pub profile : Option < IccProfileHandle > , # [doc = " Resize, if any."] # [serde (default)] pub resize : Option < Resize > , # [doc = " Embed XMP metadata (ratings, keywords, IPTC)."] # [serde (default = "yes")] pub embed_metadata : bool , # [doc = " Write HDR (gain map or PQ/HLG, format permitting)."] # [serde (default)] pub hdr : bool , } fn default_template () -> String { "{name}" . into () } fn yes () -> bool { true } # [doc = " Adjust global tone/colour controls."] # [derive (Debug , Clone , Serialize , Deserialize , schemars :: JsonSchema)] # [serde (deny_unknown_fields)] pub struct SetTone { # [doc = " Target image."] image : ImageId , # [doc = " Controls to change."] # [serde (flatten)] update : ToneUpdate , # [doc = " One-line rationale recorded on the history entry."] # [serde (default)] pub rationale : Option < String > , # [doc = " History group to record into (e.g. \"Agent base edit\")."] # [serde (default)] pub group : Option < HistoryGroupId > , # [doc = " Optimistic concurrency: fail with [`EngineError::Conflict`] if the"] # [doc = " image's recipe hash no longer matches."] # [serde (default)] pub expect_reci