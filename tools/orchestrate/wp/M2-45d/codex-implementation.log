    let parts=segments(bytes);let (pos,_,mpf)=parts.iter().find(|(_,m,b)|*m==0xe2 && b.starts_with(b"MPF\0")).unwrap();
    let t=&mpf[4..];assert_eq!(&t[..4],b"MM\0\x2a");
    let d=u32::from_be_bytes(t[4..8].try_into().unwrap()) as usize;
