fn settings(destination: &Path, extra: serde_json::Value) -> String {
    let mut json = serde_json::json!({
        "format": "jpeg",
        "quality": 85,
        "resize": {"mode": "long_edge", "long_edge": 24},
        "naming": "{name}",
        "dpi": 240,
        "destination": destination.to_string_lossy(),
    });
    for (k, v) in extra.as_object().unwrap() {
        json[k] = v.clone();
    }
    json.to_string()
