    pub original_raw: Option<PathBuf>,
}
impl Default for ExportSettings {
    fn default() -> Self {
        Self {
            format: Format::Jpeg { quality: 90 },
            hdr: None,
            color_space: ColorSpace::Srgb,
            metadata: Metadata::All,
            remove_person_info: false,
            remove_location: false,
