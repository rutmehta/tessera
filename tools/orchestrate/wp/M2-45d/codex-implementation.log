    assert_eq!(&bytes[..2],b"\xff\xd8");let mut result=Vec::new();let mut p=2;
    while bytes[p+1]!=0xda {let n=u16::from_be_bytes(bytes[p+2..p+4].try_into().unwrap()) as usize;result.push((p,bytes[p+1],&bytes[p+4..p+2+n]));p+=2+n;}result
