+            let resident = RESIDENT
+                .lock()
+                .unwrap()
+                .iter()
+                .find(|(generation, level, _)| {
+                    *generation == frame.generation && *level == frame.level
+                })
+                .map(|(_, _, output)| {
+                    assert_eq!(*output, expected_output);
