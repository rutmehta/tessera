+        .set_settings(json!({"tone":{"exposure":0.75}}).to_string(), false)
+        .unwrap();
+    session.flush().unwrap();
+    session.close().unwrap();
+    drop(session);
+    let before = f.engine.cache_probe_for_test();
+    f.cycle();
+    let edited = f.engine.cache_probe_for_test();
+    assert_eq!(edited.measurements, before.measurements + 1);
+    assert_ne!(edited.generation, rebuilt.generation);
+    assert_ne!(edited.recipe_digest, rebuilt.recipe_digest);
+    assert!(
+        f.engine.clone().open_develop_session(f.id.clone()).is_err(),
+        "dirty local recipe must still block Original"
+    );
 }
 
