+/// Export a document to PSD with caller cancellation through live rendering,
+/// node traversal, and raster/channel assembly. Metadata clones, vector/text
+/// rasterization, placed-raster copies, and PSD encoding are boundary-checked
+/// opaque operations; serialization of the returned PSD remains separate.
+pub fn to_psd_with_cancel(
+    document: &crate::Document,
+    cancel: &CancellationToken,
+) -> EngineResult<PsdDocument> {
+    cancel.check()?;
+    let mut imported = match &document.psd_source {
+        Some(source) => source.as_ref().clone(),
+        None => ImportedPsd::from_state((**document.state()).clone())?,
+    };
+    cancel.check()?;
+    imported.state = (**document.state()).clone();
+    cancel.check()?;
+    export_imported(&imported, cancel)
+}
