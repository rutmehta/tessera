+    use super::*;
+
+    #[test]
+    fn row_checkpoint_stops_before_later_rows_and_retry_is_independent() {
+        let cancel = CancellationToken::new();
+        let mut visited = Vec::new();
+        let result = checked_rows(0, 3, &cancel, |y| {
+            visited.push(y);
+            cancel.cancel();
+            Ok(())
+        });
+        assert_eq!(result, Err(EngineError::Cancelled));
+        assert_eq!(visited, [0]);
+
+        let mut retry = Vec::new();
+        checked_rows(0, 3, &CancellationToken::new(), |y| {
+            retry.push(y);
+            Ok(())
+        })
+        .unwrap();
+        assert_eq!(retry, [0, 1, 2]);
+    }
+
