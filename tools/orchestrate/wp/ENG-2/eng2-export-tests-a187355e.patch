+/// A later committed edit does not change the document captured at confirm.
+#[test]
+fn export_snapshot_excludes_later_committed_edit() {
+    let (dir, engine) = engine();
+    let s = engine.adopt_document(document(900, 600), "confirm-commit".into());
+    let top = s.layers().unwrap()[0].id;
+
+    let before = dir.path().join("before-commit.png");
+    s.export_flat(
+        before.to_string_lossy().into_owned(),
+        ExportFormat::Png,
+        90,
+        ExportColor::Srgb,
+    )
+    .unwrap();
+
+    let out = dir.path().join("confirmed.png");
+    let job = s
+        .begin_export_flat(
+            out.to_string_lossy().into_owned(),
+            ExportFormat::Png,
+            90,
+            ExportColor::Srgb,
+        )
+        .unwrap();
+    s.set_visible(top, false).unwrap();
+    let after = dir.path().join("after-commit.png");
+    s.export_flat(
+        after.to_string_lossy().into_owned(),
+        ExportFormat::Png,
+        90,
+        ExportColor::Srgb,
+    )
+    .unwrap();
+    assert_ne!(png_pixels(&before), png_pixels(&after), "edit must be visible");
+
+    job.run(None).unwrap();
+    assert_eq!(png_pixels(&out), png_pixels(&before));
+    assert_ne!(png_pixels(&out), png_pixels(&after));
+}
